  "decision_rules": {
    "alpha": 0.05,
    "equivalence_margin": {
      "cost_at_equal_quality": {
        "acceptance_probability": 0.1,
        "heldout_quality": 0.1,
        "rule": "CSE-5: both must pass or cost claims stay unconditional",
        "sidedness": "two-sided 0.90"
      }
    },
    "multiplicity": "single primary endpoint",
    "power": 0.8,
    "primary_rule": "one-sided superiority at alpha 0.05 on the pooled Newcombe interval lower bound > 0 with no reversed stratum; otherwise weakened/rejected/undecidable by the #358 rule (CSE-3)",
    "smallest_effect": {
      "measure": "risk difference in session success",
      "value": 0.25
    },
    "stopping_rule": "fixed n from the frozen power analysis using pilot-only control success; absolute floor 10 randomized assignments per arm per agent-system x task stratum (CSE-8); no optional stopping or extension"
  },
  "disposition": "registered 2026-09-13; collection pending. Supersedes the zero-session pilot-v1 lineage with the instrument set the pilot can actually run on (T1-L2 realistic pair, #581 to #586). Named limitations: BND-7 not eligible (recorded failed), external-review and parity gates pending, and the session-bound capability audit not merged (an unattested environment stops every session).",
  "endpoints": {
    "primary": [
      {
        "aggregation": "risk difference typed_dataflow - monolithic; exact arm intervals; Newcombe interval; per agent-system x task stratum before pooling (CSE-1, CSE-17)",
        "direction": "higher",
        "id": "E-CSE-1",
        "outcome": "session_success",
        "status": "inferential",
        "unit": "agent_session"
      }
    ],
    "secondary": [
      {
        "aggregation": "counts by arm",
        "direction": "descriptive",
        "id": "E-CSE-2",
        "outcome": "validation_and_launch_failure_class",
        "status": "descriptive",
        "unit": "agent_session"
      },
      {
        "aggregation": "Kaplan-Meier with censoring",
        "direction": "lower",
        "id": "E-CSE-3",
        "outcome": "time_to_first_accepted_system",
        "status": "descriptive",
        "unit": "agent_session"
      },
      {
        "aggregation": "unconditional session estimands; no at-equal-quality wording unless CSE-5 equivalence passes",
        "direction": "lower",
        "id": "E-CSE-4",
        "outcome": "tokens_tool_calls_wall_active_time_sim_work_rollouts",
        "status": "descriptive",
        "unit": "agent_session"
      },
      {
        "aggregation": "counts",
        "direction": "descriptive",
        "id": "E-CSE-5",
        "outcome": "safety_interventions",
        "status": "descriptive",
        "unit": "agent_session"
      },
      {
        "aggregation": "dropped unless a blinded rubric is ratified before freeze (CSE-18)",
        "direction": "n/a",
        "id": "E-CSE-6",
        "outcome": "artifact_legibility",
        "status": "exploratory",
        "unit": "agent_session"
      }
    ]
  },
  "exclusions": {
    "deviation_policy": "any behaviour-affecting change after registration is a documented deviation record and a new campaign version id; confirmatory data never revises the registered protocol",
    "infrastructure": [
      "independent-controller-determined, arm-neutral facts only (CSE-14): host outage, provider interruption before first tool call, launcher crash before the session started"
    ],
    "rerun_policy": "a permitted rerun receives a new randomized id; the original row is retained with its exclusion reason and never replaced in place",
    "treatment_integrity": [
      "contamination sentinel tripped (CSE-12)",
      "model alias or CLI drift outside the frozen identity (CSE-6)",
      "integrity verdict authored session-side (CSE-11)"
